# Copy to .env on the server. Never commit the real password.
DUKKEOBI_DB_PASSWORD=

# Keep these safe defaults until the original PostGIS/GeoServer dataset exists.
DUKKEOBI_DATA_AVAILABLE=false
DUKKEOBI_READ_ONLY=true

# Optional browser map key. Restrict it to the production domain at VWorld.
DUKKEOBI_VWORLD_KEY=
